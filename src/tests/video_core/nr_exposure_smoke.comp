#version 450
#extension GL_GOOGLE_include_directive : require
#include "nr_native_exposure.glsl"
layout(local_size_x = 1) in;
layout(std430, binding = 0) writeonly buffer Result { vec4 result[]; };
layout(push_constant) uniform Push { vec4 scene; vec4 changed; } params;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i == 0) result[i] = vec4(nativeExposureForward(params.scene.rgb), 1);
    if (i == 1) result[i] = vec4(nativeExposureInverse(nativeExposureForward(params.scene.rgb)), 1);
    if (i == 2) result[i] = vec4(nativeExposureInverse(params.changed.rgb), 1);
    if (i == 3) result[i] = vec4(nativeExposureForward(nativeExposureInverse(params.changed.rgb)), 1);
}
