#version 450

layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0) uniform sampler2D dlss_color;
layout(binding = 1, rgba8) uniform writeonly image2D guest_color;

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(guest_color)))) {
        return;
    }
    vec3 color = texelFetch(dlss_color, pixel, 0).rgb;
    if (any(isnan(color)) || any(isinf(color))) {
        return;
    }
    // The intervening guest draw and final network leave one sRGB encoding in this UNORM store.
    color = clamp(color, 0.0, 1.0);
    vec3 encoded = mix(1.055 * pow(color, vec3(1.0 / 2.4)) - 0.055,
                       12.92 * color, lessThanEqual(color, vec3(0.0031308)));
    imageStore(guest_color, pixel, vec4(encoded, 1.0));
}
